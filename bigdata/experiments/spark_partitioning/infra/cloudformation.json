{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Disposable WITW A/B partitioning experiment; fixed 4 executor cores",
  "Parameters": {
    "Ami": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id"
    },
    "KeyName": {
      "Type": "String",
      "Default": ""
    },
    "PublicKeyMaterial": {
      "Type": "String",
      "Default": ""
    },
    "SshCidr": {
      "Type": "String",
      "AllowedPattern": "(\\d{1,3}\\.){3}\\d{1,3}/32",
      "Description": "Only controller public IPv4 /32"
    },
    "BudgetHours": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 1,
      "MaxValue": 20
    }
  },
  "Conditions": {
    "CreateOwnedKey": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PublicKeyMaterial"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.91.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.91.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "LabSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Only this disposable experiment",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "SshCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "LabInternal": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "LabSecurityGroup"
        },
        "SourceSecurityGroupId": {
          "Ref": "LabSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 1,
        "ToPort": 65535
      }
    },
    "HeadRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "StopOnlyOwnedExperiment",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:StopInstances"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/OwnerStackId": {
                        "Ref": "AWS::StackId"
                      }
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "HeadProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HeadRole"
          }
        ]
      }
    },
    "OwnedKeyPair": {
      "Type": "AWS::EC2::KeyPair",
      "Condition": "CreateOwnedKey",
      "Properties": {
        "KeyName": {
          "Ref": "AWS::StackName"
        },
        "PublicKeyMaterial": {
          "Ref": "PublicKeyMaterial"
        },
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          }
        ]
      }
    },
    "Head": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "m7i.xlarge",
        "KeyName": {
          "Fn::If": [
            "CreateOwnedKey",
            {
              "Ref": "OwnedKeyPair"
            },
            {
              "Ref": "KeyName"
            }
          ]
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "Subnet"
            },
            "AssociatePublicIpAddress": true,
            "GroupSet": [
              {
                "Ref": "LabSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 40,
              "VolumeType": "gp3",
              "Iops": 3000,
              "DeleteOnTermination": true,
              "Encrypted": true
            }
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          },
          {
            "Key": "NodeRole",
            "Value": "head"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\nexec > >(tee /var/log/witw-head-init.log) 2>&1\napt-get update\nDEBIAN_FRONTEND=noninteractive apt-get install -y python3-boto3 curl ca-certificates\ninstall -d -m 755 /opt/witw/publish /opt/witw/results /opt/witw/state\ncat >/opt/witw/stop_owned.py <<'PY'\nimport boto3,json,os,subprocess,time\nfrom pathlib import Path\nstack='${AWS::StackId}'\nec2=boto3.client('ec2',region_name='${AWS::Region}')\nr=ec2.describe_instances(Filters=[{'Name':'tag:OwnerStackId','Values':[stack]},{'Name':'instance-state-name','Values':['pending','running']}])\nids=[i['InstanceId'] for x in r['Reservations'] for i in x['Instances']]\nPath('/opt/witw/results/BUDGET_STOP.json').write_text(json.dumps({'epoch':time.time(),'stack':stack,'instances':ids}))\ntry:\n p=subprocess.run(['docker','ps','-q','--filter','label=witw.experiment=${AWS::StackName}'],capture_output=True,text=True)\n if p.returncode==0 and p.stdout.split():subprocess.run(['docker','stop','--timeout','30',*p.stdout.split()],timeout=50)\nexcept Exception as e:print('Container stop failed; still stopping owned EC2:',str(e),flush=True)\nos.sync()\nif ids:ec2.stop_instances(InstanceIds=ids)\nPY\ncat >/etc/systemd/system/witw-budget.service <<'UNIT'\n[Unit]\nDescription=Preserve data and stop only this experiment at budget deadline\n[Service]\nType=oneshot\nExecStart=/usr/bin/python3 /opt/witw/stop_owned.py\nUNIT\ndeadline=$(date -u -d \"+${BudgetHours} hours\" \"+%Y-%m-%d %H:%M:%S UTC\")\ndate -u -d \"$deadline\" +%s >/opt/witw/state/deadline_epoch\ncat >/etc/systemd/system/witw-budget.timer <<UNIT\n[Unit]\nDescription=Owned experiment budget deadline\n[Timer]\nOnCalendar=$deadline\nPersistent=true\nUnit=witw-budget.service\n[Install]\nWantedBy=timers.target\nUNIT\ncat >/etc/systemd/system/witw-publish.service <<'UNIT'\n[Unit]\nDescription=Private artifact publisher for experiment workers\n[Service]\nExecStart=/usr/bin/python3 -m http.server 8090 --bind 0.0.0.0 --directory /opt/witw/publish\nRestart=always\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now witw-budget.timer witw-publish.service\n"
          }
        },
        "IamInstanceProfile": {
          "Ref": "HeadProfile"
        }
      }
    },
    "Worker1": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "m7i.large",
        "KeyName": {
          "Fn::If": [
            "CreateOwnedKey",
            {
              "Ref": "OwnedKeyPair"
            },
            {
              "Ref": "KeyName"
            }
          ]
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "Subnet"
            },
            "AssociatePublicIpAddress": false,
            "GroupSet": [
              {
                "Ref": "LabSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Iops": 3000,
              "DeleteOnTermination": true,
              "Encrypted": true
            }
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          },
          {
            "Key": "NodeRole",
            "Value": "worker-1"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\nexec > >(tee /var/log/witw-worker-init.log) 2>&1\npython3 - <<'PY'\nimport time,urllib.request,subprocess\nurl='http://${Head.PrivateIp}:8090/node_bootstrap.py'\nfor _ in range(720):\n try:\n  data=urllib.request.urlopen(url,timeout=10).read()\n  open('/tmp/witw-node-bootstrap.py','wb').write(data)\n  subprocess.run(['python3','/tmp/witw-node-bootstrap.py','--role','worker-1','--head','${Head.PrivateIp}','--experiment','${AWS::StackName}'],check=True)\n  break\n except Exception as e:\n  print(type(e).__name__,str(e),flush=True);time.sleep(10)\nelse:raise RuntimeError('Private bootstrap did not become ready within two hours')\nPY\n"
          }
        }
      }
    },
    "Worker2": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "Ami"
        },
        "InstanceType": "m7i.large",
        "KeyName": {
          "Fn::If": [
            "CreateOwnedKey",
            {
              "Ref": "OwnedKeyPair"
            },
            {
              "Ref": "KeyName"
            }
          ]
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "Subnet"
            },
            "AssociatePublicIpAddress": false,
            "GroupSet": [
              {
                "Ref": "LabSecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 20,
              "VolumeType": "gp3",
              "Iops": 3000,
              "DeleteOnTermination": true,
              "Encrypted": true
            }
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "Tags": [
          {
            "Key": "ExperimentId",
            "Value": {
              "Ref": "AWS::StackName"
            }
          },
          {
            "Key": "OwnerStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Purpose",
            "Value": "witw-spark-partitioning-only"
          },
          {
            "Key": "NodeRole",
            "Value": "worker-2"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euo pipefail\nexec > >(tee /var/log/witw-worker-init.log) 2>&1\npython3 - <<'PY'\nimport time,urllib.request,subprocess\nurl='http://${Head.PrivateIp}:8090/node_bootstrap.py'\nfor _ in range(720):\n try:\n  data=urllib.request.urlopen(url,timeout=10).read()\n  open('/tmp/witw-node-bootstrap.py','wb').write(data)\n  subprocess.run(['python3','/tmp/witw-node-bootstrap.py','--role','worker-2','--head','${Head.PrivateIp}','--experiment','${AWS::StackName}'],check=True)\n  break\n except Exception as e:\n  print(type(e).__name__,str(e),flush=True);time.sleep(10)\nelse:raise RuntimeError('Private bootstrap did not become ready within two hours')\nPY\n"
          }
        }
      }
    }
  },
  "Outputs": {
    "HeadPublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Head",
          "PublicIp"
        ]
      }
    },
    "HeadPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Head",
          "PrivateIp"
        ]
      }
    },
    "Worker1PrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Worker1",
          "PrivateIp"
        ]
      }
    },
    "Worker2PrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Worker2",
          "PrivateIp"
        ]
      }
    },
    "HeadId": {
      "Value": {
        "Ref": "Head"
      }
    },
    "Worker1Id": {
      "Value": {
        "Ref": "Worker1"
      }
    },
    "Worker2Id": {
      "Value": {
        "Ref": "Worker2"
      }
    },
    "AvailabilityZone": {
      "Value": {
        "Fn::GetAtt": [
          "Head",
          "AvailabilityZone"
        ]
      }
    }
  }
}