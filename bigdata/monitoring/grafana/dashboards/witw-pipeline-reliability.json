{
  "uid": "witw-pipeline-reliability",
  "title": "WITW 장애 감지와 전달 상태",
  "id": null,
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "witw",
    "reliability",
    "alertmanager"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "경보 규칙",
      "url": "/alerting/list",
      "type": "link"
    },
    {
      "title": "알림 일시 중지",
      "url": "/alerting/silences",
      "type": "link"
    },
    {
      "title": "전체 파이프라인",
      "url": "/d/witw-pipeline",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "지표 수집 상태 (1 정상 / 0 실패)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"collector|backend-pipeline|kafka-offsets|spark-streaming|alertmanager\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "현재 경보 (pending / firing)",
      "description": "장애 판정과 전송은 Prometheus와 Alertmanager가 담당합니다. 데이터 없음은 경보 없음 또는 Prometheus 연결 실패일 수 있으므로 왼쪽 수집 상태와 함께 확인하세요.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Collector 재전송 대기 건수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "witw_collector_outbox_pending",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "SQLite에 보관한 미전송 기사 수. Kafka ACK를 받은 뒤 감소합니다."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Collector 가장 오래된 전송 대기",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "witw_collector_outbox_oldest_age_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "900초 초과가 2분간 유지되면 CollectorDeliveryStalled 경보가 발생합니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB 참조 대기 건수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "witw_dbwriter_pending_events",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 가장 오래된 참조 대기",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "witw_dbwriter_pending_oldest_age_seconds",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "300초 초과가 2분간 유지되면 DbWriterDependenciesStalled 경보가 발생합니다."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Kafka 미처리 메시지",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"nlp-worker-v1|db-writer-.*\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "수집 발견 → DB 반영 p95 (최근 10분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(witw_dbwriter_article_delivery_seconds_bucket[10m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "기사 수집 발견 시각부터 DB 반영까지의 히스토그램 추정값. 처리 표본이 없으면 No data입니다."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Collector ACK / 전송 실패 누계",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"witw_collector_delivery_(acknowledged|failures)_total\"}",
          "legendFormat": "{{__name__}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "DB 이벤트 처리 속도",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, instance) (rate(witw_dbwriter_events_total[5m]))",
          "legendFormat": "{{outcome}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "웹훅 전송 시도 (최근 10분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (integration) (increase(alertmanager_notifications_total{integration=\"webhook\"}[10m]))",
          "legendFormat": "{{integration}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "웹훅 전송 실패 (최근 10분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bigdata"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (integration) (increase(alertmanager_notifications_failed_total{integration=\"webhook\"}[10m]))",
          "legendFormat": "{{integration}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "templating": {
    "list": []
  }
}
